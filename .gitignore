# --- dependencies & generated client libs -------------------------------------------------------
node_modules/
# copied from node_modules by tools/vendor.mjs (postinstall); never commit third-party builds
public/vendor/

# --- game assets: (c) Hypergryph / Yostar, fetched or extracted locally, NEVER committed ----------
# tools/fetch-assets.mjs → public/assets/** (~250 MB) and public/fonts/** (+ fonts.css)
public/assets/
public/fonts/
# tools/local-extract/extract.py → public/assets/local/** and this per-machine manifest
# (optional: the client and the tests work without it)
data/local-assets.json
# download caches, upstream tables, ledgers, reports, setup state
.cache/

# --- Python (optional local-client extraction) ----------------------------------------------------
.venv*/
venv/
__pycache__/
*.py[cod]

# --- content packs (docs/PACKS.md): the pack index for a static host, generated by `node tools/packs.mjs index`
# (the server answers /packs/index.json itself; tools/package.mjs writes this file into the release zips) -----------
packs/index.json

# --- tests & logs ----------------------------------------------------------------------------------
test/e2e/out/
logs/
*.log

# --- per-machine config (scripts/install-service-windows.ps1) ------------------------------------
scripts/service.env.cmd
.env
.env.*

# --- OS / editor clutter ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/
.claude/

# --- 启动器 / Windows 便携包 (scripts/launcher.mjs) ----------------------------------------------
# 每台机器自己的端口 / 局域网共享 / 上次连的地址，不进版本库
scripts/launcher.config.json

# --- 本地/部署辅助(不进 git; 上游无这些文件, merge 不受影响) ----------------
node/
cloudflared/
*.tgz
*.zip
*.7z
merge_backup/
merge-reports/
merge-tmp/
rhine_ref/
rhine_upstream/
rollback_tmp/
_gen_local_assets.mjs
_probe_assets.mjs
_verify_manifest.mjs
_merge_chat.ps1
stronghold.service
# 注：仓库根的原地启动器 启动游戏.bat / 本机当服务器.bat / 联机.bat / 连接服务器.bat 是**要进版本库**的
# （它们指向 scripts/launcher.mjs，供直接在仓库里运行）。便携包根目录的那一份由
# scripts/make-windows-bundle.mjs 自己生成，因此打包时会跳过这四个（见 SKIP_ROOT_FILES）。

# --- 本地跑测试时的临时目录（本机 %TEMP% 不可写时用 .testtmp 顶上） ----------------------
.testtmp/